# LOCAL DEVELOPMENT ONLY. Change before running the stack.
MYSQL_ROOT_PASSWORD=local-dev-mysql-password
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long
FRONTEND_ORIGIN=http://localhost:5173

# Docker Compose frontend container uses the internal gateway address.
API_GATEWAY_URL=http://api-gateway:8080

# For a separately hosted static frontend (not the Docker/Nginx frontend),
# set VITE_API_BASE_URL to the public HTTPS API Gateway URL at build time.
# VITE_API_BASE_URL=https://api.example.com
