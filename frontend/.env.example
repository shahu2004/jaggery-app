# Leave blank to use the same-origin /api route.
# In local Vite development, /api is proxied to VITE_DEV_API_TARGET.
# For a static frontend host without an /api reverse proxy, set this to the
# public HTTPS URL of your Spring Cloud API Gateway.
VITE_API_BASE_URL=

# Local Spring Cloud Gateway address used only by the Vite development proxy.
VITE_DEV_API_TARGET=http://localhost:8080
